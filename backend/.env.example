# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/ztna_db

# JWT
JWT_SECRET=ztna_secret_key
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# Email (Nodemailer - SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=

# SMS Provider (e.g. Twilio)
SMS_PROVIDER=twilio
SMS_API_KEY=
SMS_API_SECRET=
SMS_FROM_NUMBER=

# Threat Intelligence / IP Reputation
THREAT_INTEL_API_KEY=
THREAT_INTEL_PROVIDER=abuseipdb

# Geo Location
GEO_API_KEY=

# Frontend origin (CORS)
CLIENT_URL=http://localhost:3000
